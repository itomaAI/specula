{
  "name": "specula",
  "version": "0.1.0",
  "description": "The specification layer for software engineering. Extract, formally verify, and manage specifications as the single source of truth.",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "build:itera": "npm run build && esbuild dist/src/index.js --bundle --format=esm --platform=browser --target=es2022 --external:node:* --outfile=dist/specula.itera.js",
    "test": "node --test \"dist/tests/**/*.test.js\""
  },
  "dependencies": {
    "@babel/parser": "8.0.10"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  },
  "keywords": [
    "specification",
    "formal-methods",
    "alloy",
    "model-checking",
    "ast",
    "bdd"
  ],
  "author": "itomaAI",
  "license": "MIT"
}